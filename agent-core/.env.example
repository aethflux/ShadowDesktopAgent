# =============================================================================
# Hoshino Agent Core — environment variables
# =============================================================================
# Copy this file to `.env` and fill in your keys. Never commit `.env` to git.
#
# QUICK START (cloud):
#   cp .env.example .env
#   # set MINIMAX_API_KEY + MODELSCOPE_API_KEY below
#   docker compose up
#
# The default setup uses MiniMax for chat and ModelScope for vision/embeddings.
# If ModelScope is unavailable, you can temporarily fall back to `hash`
# embeddings for local development and CI.
# =============================================================================

# ---- Server ----
APP_NAME=Hoshino Agent Core
HOST=127.0.0.1
PORT=8787
DESKTOP_ORIGIN=http://localhost:5173

# ---- LLM Provider (vllm | openai | anthropic | minimax | modelscope) ----
# Switch at any time without code changes. Each provider has sane defaults.
PROVIDER=minimax

# Per-provider model overrides (optional — leave empty to use defaults).
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o-mini
VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct
MINIMAX_MODEL=MiniMax-M2.7          # Token/Coding plan 默认可用；需要更快可尝试高权限下的 M2.7-highspeed

# ---- API credentials ----
# Anthropic (recommended — enables Prompt Caching + cache_control)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# OpenAI
OPENAI_API_KEY=sk-xxxxx

# Local vLLM (used when PROVIDER=vllm)
VLLM_API_BASE=http://127.0.0.1:8000/v1
VLLM_API_KEY=EMPTY

# MiniMax（推荐中国用户，高性价比，支持 OpenAI-compatible 格式）
MINIMAX_API_BASE=https://api.minimax.chat/v1
MINIMAX_API_KEY=EMG-xxxxxxxxxxxxxxxx

# ---- Vision model for screen/image understanding ----
# Text chat can stay on MiniMax while screenshots/images use ModelScope VL.
VISION_PROVIDER=modelscope
VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
MODELSCOPE_MODEL=Qwen/Qwen3-VL-8B-Instruct

# ---- Voice ----
# 默认使用 Edge Neural TTS，失败时桌面端会自动回退到浏览器语音。
ENABLE_EDGE_TTS=true
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_PITCH=+0Hz

# ModelScope CosyVoice2 Studio 目前可能返回静音音频；确认可用后再启用。
ENABLE_MODELSCOPE_TTS=false
MODELSCOPE_TTS_API_BASE=https://iic-cosyvoice2-0-5b.ms.show
MODELSCOPE_TTS_MODEL=iic/CosyVoice2-0.5B
MODELSCOPE_TTS_MODE=自然语言控制
MODELSCOPE_TTS_INSTRUCTION=用温柔自然的中文女声朗读
MODELSCOPE_TTS_SEED=0

# MiniMax TTS — 确认当前 MiniMax Token Plan key 有对应 speech 模型额度后再启用。
ENABLE_MINIMAX_VOICE=false
MINIMAX_VOICE_API_BASE=https://api.minimax.chat/v1
MINIMAX_TTS_VOICE_ID=Chinese (Mandarin)_Warm_Girl
MINIMAX_TTS_MODEL=speech-2.8-hd
MINIMAX_TTS_SPEED=1.0
MINIMAX_ASR_MODEL=whisper-1

# Gemini 3.1 Flash TTS — 备选方案，默认关闭。
ENABLE_GEMINI_TTS=false
GEMINI_TTS_API_KEY=
GEMINI_TTS_API_BASE=https://generativelanguage.googleapis.com
GEMINI_TTS_MODEL=google/gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore   # 可选: Kore, Ash, Fen, Iris, Lake, Deck, Dora, Maverick
GEMINI_TTS_SPEED=1.0
GEMINI_TTS_OUTPUT_FORMAT=mp3

# ---- Semantic memory ----
ENABLE_SEMANTIC_MEMORY=true
EMBEDDING_PROVIDER=modelscope      # modelscope | openai | hash
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024
MODELSCOPE_API_BASE=https://api-inference.modelscope.cn/v1
MODELSCOPE_API_KEY=
# 若未配置 ModelScope key，可临时降级到：
# EMBEDDING_PROVIDER=hash
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=256

# ---- Prompt Caching ----
# Anthropic: attaches cache_control to system prompts (recommended: true).
# OpenAI: prefix-stable system prompts are auto-cached by the API.
ENABLE_PROMPT_CACHE=true

# ---- Paths (defaults are under agent-core/ — only override if needed) ----
# MEMORY_DIR=agent-core/memory
# SKILLS_DIR=agent-core/skills
# SCREENSHOTS_DIR=agent-core/artifacts/screenshots
# CHROMA_DIR=agent-core/memory/chroma

# ---- Execution safety ----
# Terminal commands are restricted to this workspace root. GUI automation is
# disabled by default because it can click/type on the real desktop.
# COMMAND_WORKSPACE_ROOT=..
ENABLE_GUI_AUTOMATION=false
EXTERNAL_CLI_ALLOWLIST=git,node,npm,npx,python,python3,py,pwsh,powershell

# MCP: filesystem MCP exposes only the local skills directory. Add external
# stdio MCP servers with a single-line JSON object when needed, for example:
# MCP_SERVERS_JSON={"time":{"command":"npx","args":["-y","@modelcontextprotocol/server-time"]}}
ENABLE_FILESYSTEM_MCP=true
MCP_SERVERS_JSON=
MCP_TOOL_DENYLIST=write_file,edit_file,create_directory,move_file
MCP_TOOL_BLOCKED_KEYWORDS=write,edit,delete,remove,move,create,rename
